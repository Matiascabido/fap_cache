# Redis service hostname para uso local con docker-compose.
# Si desplegás en Render con el contenedor único y Redis integrado,
# define REDIS_HOST=localhost en las variables de entorno de Render.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Si usas Redis con contraseña, ponla aquí
REDIS_PASSWORD=

# TTL por defecto en segundos para caché
CACHE_TTL_SECONDS=60

# Configuración de la API
API_PORT=8000
API_WORKERS=4
CACHE_LIST_LIMIT=100
